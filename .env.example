# ─── 9Router Environment Configuration ──────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# ⚠️  WARNING: Never commit the actual .env file to version control.
#    It contains production secrets!

# ─── Authentication ─────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-hex-string
INITIAL_PASSWORD=change-me-to-a-strong-password
API_KEY_SECRET=change-me-to-a-random-64-char-hex-string
MACHINE_ID_SALT=change-me-to-a-random-32-char-hex-string

# ─── Application ────────────────────────────────────────
DATA_DIR=/app/data
PORT=20128
NODE_ENV=production
HOSTNAME=0.0.0.0
BASE_URL=https://your-domain.com
CLOUD_URL=https://your-domain.com
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_CLOUD_URL=https://your-domain.com

# ─── Feature Flags ──────────────────────────────────────
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=true
REQUIRE_API_KEY=true

# ─── Internal Services ──────────────────────────────────
HEADROOM_URL=http://headroom:8787
SEARXNG_URL=http://searxng:8080/search

# ─── Proxy (optional) ───────────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=
